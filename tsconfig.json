{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "src",
    ".expo/types",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
